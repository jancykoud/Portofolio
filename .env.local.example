# KOUD AI — clé serveur Anthropic (https://console.anthropic.com). Sans clé : assistant affiché « Non activé ».
ANTHROPIC_API_KEY=
# Optionnel : modèle utilisé par KOUD AI
KOUD_AI_MODEL=claude-opus-5-5

# Formulaire de contact — https://resend.com/api-keys
RESEND_API_KEY=
# Optionnel : destinataire et expéditeur vérifié (domaine validé dans Resend)
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# URL publique canonique
NEXT_PUBLIC_SITE_URL=https://koud-portfolio.netlify.app
